import json
import os
import tempfile
from google.oauth2 import service_account
from googleapiclient.discovery import build
from googleapiclient.http import MediaFileUpload

SCOPES = ['https://www.googleapis.com/auth/drive.file']
SERVICE_ACCOUNT_FILE = 'drive_creds.json'
DRIVE_FOLDER_ID = '1CfuVvXdpUtYzcYkFa9R9ashU4NyFrJo6'

def get_drive_service():
    creds = service_account.Credentials.from_service_account_file(
        SERVICE_ACCOUNT_FILE, scopes=SCOPES
    )
    return build('drive', 'v3', credentials=creds)

def archive_short_to_drive(video_path: str, title: str, description: str, tags: list[str], delete_local: bool = True):
    """Uploads the rendered MP4 and matching JSON metadata to your Google Drive folder."""
    service = get_drive_service()
    base_name = os.path.splitext(os.path.basename(video_path))[0]

    # 1. Upload the MP4 video
    video_metadata = {'name': f"{base_name}.mp4", 'parents': [DRIVE_FOLDER_ID]}
    video_media = MediaFileUpload(video_path, mimetype='video/mp4', resumable=True)
    uploaded_video = service.files().create(
        body=video_metadata, media_body=video_media, fields='id'
    ).execute()

    # 2. Create and upload the matching JSON metadata file (cross-platform temp file)
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False, encoding='utf-8') as tmp:
        json.dump({"title": title, "description": description, "tags": tags}, tmp, indent=2)
        meta_path = tmp.name

    try:
        json_metadata = {'name': f"{base_name}.json", 'parents': [DRIVE_FOLDER_ID]}
        json_media = MediaFileUpload(meta_path, mimetype='application/json')
        service.files().create(body=json_metadata, media_body=json_media, fields='id').execute()
    finally:
        if os.path.exists(meta_path):
            os.remove(meta_path)

    # 3. Clean up local MP4 after successful upload to save disk space
    if delete_local and os.path.exists(video_path):
        os.remove(video_path)

    print(f"Uploaded to Drive: {base_name}.mp4 (File ID: {uploaded_video.get('id')})")
    return uploaded_video.get('id')
